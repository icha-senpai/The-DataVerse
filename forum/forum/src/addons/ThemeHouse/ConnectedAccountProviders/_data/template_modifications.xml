<?xml version="1.0" encoding="utf-8"?>
<template_modifications>
  <modification type="public" template="account_details" modification_key="thconacc_account_details_removeEmail" description="Conditionally remove email change button" execution_order="10" enabled="1" action="preg_replace">
    <find><![CDATA[/<xf:button[^\n]*'account\/email'.*button>/sU]]></find>
    <replace><![CDATA[<xf:if is="!$xf.options.thconnectedaccountproviders_updateEmail">
				$0
				</xf:if>]]></replace>
  </modification>
  <modification type="public" template="account_visitor_menu" modification_key="thconacc_account_visitor_menu" description="Conditionally remove connected accounts section" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[$xf.app.connectedAccountCount]]></find>
    <replace><![CDATA[$0 && $xf.options.thconnectedaccountproviders_enableConAccSect]]></replace>
  </modification>
  <modification type="public" template="account_visitor_menu" modification_key="thconacc_account_visitor_menu_removePw" description="Conditionally remove link to password page" execution_order="10" enabled="1" action="preg_replace">
    <find><![CDATA[/<li[^\n]*'account\/security'.*li>/sU]]></find>
    <replace><![CDATA[<xf:if is="!$xf.options.thconnectedaccountproviders_forceOauthLogin || $xf.visitor.is_admin">
		$0
		</xf:if>]]></replace>
  </modification>
  <modification type="public" template="account_wrapper" modification_key="thconacc_account_wrapper" description="Conditionally remove connected accounts section" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[$xf.app.connectedAccountCount]]></find>
    <replace><![CDATA[$0 && $xf.options.thconnectedaccountproviders_enableConAccSect]]></replace>
  </modification>
  <modification type="public" template="account_wrapper" modification_key="thconacc_account_wrapper_disablePw" description="Conditionally remove link to password page" execution_order="10" enabled="1" action="preg_replace">
    <find><![CDATA[/<a[^\n]*'security'.*a>/sU]]></find>
    <replace><![CDATA[<xf:if is="!$xf.options.thconnectedaccountproviders_forceOauthLogin || $xf.visitor.is_admin">
				$0
				</xf:if>]]></replace>
  </modification>
  <modification type="admin" template="connected_account_provider_list" modification_key="th_cap_connected_account_provider_list" description="Add add-on prefix" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<xf:datarow label="{$provider.title}"]]></find>
    <replace><![CDATA[<xf:set var="$providerTitle">
							<xf:if is="$provider.isThCapProvider()">
								<span class="label label--primary">{{ phrase('th_cap_provider_label') }}</span>
							</xf:if>
							{$provider.title}
						</xf:set>
						<xf:datarow label="{$providerTitle|raw}"]]></replace>
  </modification>
  <modification type="admin" template="connected_account_provider_list" modification_key="th_cap_connected_account_provider_list_sort" description="Add sort button" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[</xf:title>]]></find>
    <replace><![CDATA[$0

<xf:pageaction>
	<xf:button href="{{ link('connected-accounts/th-cap-sort') }}"
			   icon="sort" data-xf-click="overlay">
		{{ phrase('button.sort') }}
	</xf:button>
</xf:pageaction>]]></replace>
  </modification>
  <modification type="public" template="core_button.less" modification_key="th_cap_core_button_less" description="Add provider button styling" execution_order="10" enabled="1" action="preg_replace">
    <find><![CDATA[/$/]]></find>
    <replace><![CDATA[<xf:include template="th_cap_provider_button.less" />]]></replace>
  </modification>
  <modification type="public" template="login" modification_key="th_cap_login" description="Hide login form if OAuth login is forced" execution_order="10" enabled="1" action="preg_replace">
    <find><![CDATA[#<xf:form action="{{ link\('login/login'\) }}".*</xf:form>#sU]]></find>
    <replace><![CDATA[<xf:if is="!$xf.options.thconnectedaccountproviders_forceOauthLogin">
	$0
</xf:if>]]></replace>
  </modification>
  <modification type="public" template="login" modification_key="th_cap_login_02" description="Hide login form if OAuth login is forced" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<div class="blocks-textJoiner"><span></span><em>{{ phrase('or_separator') }}</em><span></span></div>]]></find>
    <replace><![CDATA[<xf:if is="!$xf.options.thconnectedaccountproviders_forceOauthLogin">
	$0
</xf:if>]]></replace>
  </modification>
  <modification type="public" template="register_connected_account" modification_key="thconacc_register_connected_account" description="Provide username default" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[username_row"]]></find>
    <replace><![CDATA[$0 arg-value="{$providerData.username}"]]></replace>
  </modification>
  <modification type="public" template="register_connected_account" modification_key="thconacc_register_connected_account_removeTab" description="Conditionally remove tabs" execution_order="10" enabled="1" action="preg_replace">
    <find><![CDATA[#<h2 class="block-tabHeader.*</h2>#sU]]></find>
    <replace><![CDATA[<xf:if is="$xf.options.thconnectedaccountproviders_enableConAccSect">
		$0
</xf:if>]]></replace>
  </modification>
  <modification type="public" template="register_form" modification_key="th_cap_register_form" description="Hide register form if OAuth registration is forced." execution_order="10" enabled="1" action="preg_replace">
    <find><![CDATA[#<xf:form action="{{ link\('register/register'\) }}".*</xf:form>#sU]]></find>
    <replace><![CDATA[<xf:if is="!$xf.options.thconnectedaccountproviders_forceOauthRegistration">
$0
</xf:if>]]></replace>
  </modification>
</template_modifications>
