  <phrase title="option_explain.thconnectedaccountproviders_autoCreateAccounts" version_id="1020293" version_string="1.2.2 Patch Level 3"><![CDATA[If enabled, this will bypass account creation prompt if possible, and automatically create an account from the provided 3rd party details.]]></phrase>
  <phrase title="option_explain.thconnectedaccountproviders_bypass" version_id="1000070" version_string="1.0.0"><![CDATA[Enabled services will be able to associate existing accounts upon login. <strong>Important:</strong> enable this only for services that you trust to have verified the user before login, otherwise account hijacking may be possible.]]></phrase>
  <phrase title="option_explain.thconnectedaccountproviders_enableConAccSect" version_id="1000070" version_string="1.0.0"><![CDATA[If disabled, users will not be able to access their accounts "connected accounts" section, where they can associated and disassociate connected accounts.]]></phrase>
  <phrase title="option_explain.thconnectedaccountproviders_forceOauthLogin" version_id="1010051" version_string="1.1.0 Release Candidate 1"><![CDATA[If enabled, users cannot login through a username/password combination, but only through connected account providers. This will effectively lock out users that do not have a connected account provider set up, so use with caution. This will disable the password change functionality for any non-administrator.]]></phrase>
  <phrase title="option_explain.thconnectedaccountproviders_forceOauthRegistration" version_id="1000011" version_string="1.0.0 Alpha 1"><![CDATA[If enabled, conventional registration will be disabled, and users can only register via one of the provided OAuth providers.]]></phrase>
  <phrase title="option_explain.thconnectedaccountproviders_linkProfileFields" version_id="1020293" version_string="1.2.2 Patch Level 3"><![CDATA[]]></phrase>
  <phrase title="option_explain.thconnectedaccountproviders_mapToCustom" version_id="1000070" version_string="1.0.0"><![CDATA[If enabled, additional data will be synchronized to custom user fields. Rules must be provided in the format <pre style="display:inline">provider_key=custom_user_field_id</pre> or <pre style="display:inline">provider_id;provider_key=custom_user_field_id</pre>. One rule per line.]]></phrase>
  <phrase title="option_explain.thconnectedaccountproviders_redirectAfterLogout" version_id="1010051" version_string="1.1.0 Release Candidate 1"><![CDATA[If provided, users will be redirected to this page after logout instead. You can use {url} as token, which will be replaced with the page they were currently on while logging out. This option requires force OAuth login and redirect on single provider to be enabled.]]></phrase>
  <phrase title="option_explain.thconnectedaccountproviders_redirectSingleProvider" version_id="1000011" version_string="1.0.0 Alpha 1"><![CDATA[If enabled, the user will automatically be redirected to the OAuth service upon opening a registration/login form for methods that have "Force OAuth" enabled, <strong>if</strong> there is only a single provider to chose from.]]></phrase>
  <phrase title="option_explain.thconnectedaccountproviders_updateEmail" version_id="1010051" version_string="1.1.0 Release Candidate 1"><![CDATA[If enabled, email will be updated on login based on the connected account providers provided details. This will disable the email change functionality from the user account area.]]></phrase>
  <phrase title="option_explain.thconnectedaccountproviders_updateUsername" version_id="1000070" version_string="1.0.0"><![CDATA[If enabled, username will be updated on login based on the connected account providers provided details.]]></phrase>
