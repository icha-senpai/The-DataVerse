{
  "name": "dataverse/wintercms",
  "description": "The DataVerse — powered by Winter CMS (Open Source Fork of October)",
  "type": "project",
  "homepage": "https://wintercms.com",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^10.0",
    "winter/wn-system-module": "^1.2",
    "winter/wn-backend-module": "^1.2",
    "winter/wn-cms-module": "^1.2",
    "winter/wn-editor-module": "^1.2",
    "winter/wn-tailor-module": "^1.2",
    "winter/wn-media-module": "^1.2",
    "winter/user-plugin": "^1.2",
    "winter/pages-plugin": "^1.2",
    "winter/blog-plugin": "^1.2",
    "winter/builder-plugin": "^1.2",
    "winter/translate-plugin": "^1.2",
    "winter/location-plugin": "^1.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "squizlabs/php_codesniffer": "^3.11"
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "post-autoload-dump": [
      "System\\\\Console\\\\ComposerScript::postAutoloadDump"
    ],
    "post-update-cmd": [
      "php artisan winter:up",
      "php artisan winter:util purge",
      "php artisan cache:clear"
    ],
    "test": [
      "phpunit --stop-on-failure"
    ],
    "lint": [
      "phpcs"
    ]
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "classmap": [
      "modules",
      "plugins"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.wintercms.com"
    }
  ]
}