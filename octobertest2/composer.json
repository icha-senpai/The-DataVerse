{
  "name": "october/october",
  "description": "Built using October CMS: The Laravel-Based CMS Engineered For Simplicity",
  "type": "project",
  "homepage": "https://octobercms.com",
  "license": "proprietary",

  "repositories": [
    {
      "type": "composer",
      "url": "https://gateway.octobercms.com"
    }
  ],

    "require": {
    "php": "^8.2",

    "october/rain": "4.*",
    "october/system": "4.*",
    "october/backend": "4.*",
    "october/cms": "4.*",
    "october/media": "4.*",
    "october/editor": "4.*",
    "october/dashboard": "4.*",
    "october/tailor": "4.*",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^4.2",
    "spatie/laravel-csp": "^3.14",
    "spatie/laravel-activitylog": "^4.9",
    "spatie/laravel-backup": "^9.0",
    "doctrine/dbal": "^3.8",
    "sentry/sentry-laravel": "^4.13",
    "bacon/bacon-qr-code": "^3.1",
    "composer/installers": "^2.3",
    "dasprid/enum": "1.0.7",
    "mobiledetect/mobiledetectlib": "^4.8.09",
    "rainlab/blog-plugin": "^2.0.0",
    "rainlab/builder-plugin": "^3.0.5",
    "rainlab/location-plugin": "^2.0.3",
    "rainlab/translate-plugin": "^2.2.16"
    },

  "require-dev": {
    "phpunit/phpunit": "^8.5|^9.0",
    "squizlabs/php_codesniffer": "^3.11"
  },

  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "post-autoload-dump": [
      "System\\\\Console\\\\ComposerScript::postAutoloadDump"
    ],
    "post-update-cmd": [
      "System\\\\Console\\\\ComposerScript::postUpdateCmd"
    ],
    "pre-package-uninstall": [
      "System\\\\Console\\\\ComposerScript::prePackageUninstall"
    ],
    "test": [
      "phpunit --stop-on-failure"
    ],
    "lint": [
      "phpcs"
    ]
  },

  "config": {
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true
    }
  },

  "autoload": {
    "psr-4": {
        "System\\Console\\": "modules/system/console"
    }
  },

  "minimum-stability": "stable",
  "prefer-stable": true
}
