{
  "name": "octobertest2",
  "version": "0.0.0",
  "private": true,
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1"
  },
  "scripts": {
    "format": "prettier --write \"layouts/**/*.htm\" \"pages/**/*.htm\" \"partials/**/*.htm\" \"content/**/*.htm\" \"assets/**/*.css\" \"assets/**/*.js\"",
    "build": "tailwindcss -i ./assets/css/input.css -o ./assets/css/output.css --minify",
    "watch": "tailwindcss -i ./assets/css/input.css -o ./assets/css/output.css --watch",
    "publish": "npm run build"
  },
  "dependencies": {
    "@formulajs/formulajs": "^4.6.0",
    "bootstrap": "^5.3.8",
    "tabulator-tables": "^6.5.1",
    "tinymce": "^8.6.0"
  }
}
