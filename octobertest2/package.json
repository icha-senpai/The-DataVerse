{
  "name": "octobertest2",
  "version": "0.0.0",
  "private": true,
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/cli": "^4.3.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.5.0",
    "cssnano": "^8.0.2",
    "daisyui": "^5.5.23",
    "flowbite": "^4.0.2",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.1",
    "postcss-custom-media": "^12.0.1",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^14.0.0",
    "postcss-preset-env": "^11.3.1",
    "prettier": "^3.8.4",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.1",
    "tailwindcss-filters": "^3.0.0",
    "tailwindcss-gradients": "^3.0.0"
  },
  "scripts": {
    "format": "prettier --write \"themes/dataverse/layouts/**/*.htm\" \"themes/dataverse/partials/**/*.htm\" \"themes/dataverse/assets/**/*.css\" \"themes/dataverse/assets/**/*.js\"",
    "build": "npm --prefix themes/dataverse run build",
    "build:css": "npm --prefix themes/dataverse run build",
    "watch": "npm --prefix themes/dataverse run watch",
    "watch:css": "npm --prefix themes/dataverse run watch",
    "build:postcss": "npm --prefix themes/dataverse run build:postcss",
    "watch:postcss": "npm --prefix themes/dataverse run watch:postcss",
    "copy:vendor": "npm --prefix themes/dataverse run copy:vendor",
    "build:vendor": "npm --prefix themes/dataverse run copy:vendor",
    "build:all": "npm run build && npm run copy:vendor",
    "test:vendor": "npm --prefix themes/dataverse run test:vendor",
    "publish": "npm --prefix themes/dataverse run publish",
    "publish:theme": "npm --prefix themes/dataverse run publish"
  }
}
